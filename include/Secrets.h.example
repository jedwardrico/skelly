// Secrets.h is never committed.

#define WIFI_SSID "YourWiFiName"
#define WIFI_PASSWORD "YourWiFiPassword"

// If STA connection fails within WIFI_CONNECT_TIMEOUT_MS, Skelly falls back to
// hosting this access point so you can still reach the control API.
#define AP_FALLBACK_SSID "Skelly-Setup"
#define AP_FALLBACK_PASSWORD "skellysetup"
